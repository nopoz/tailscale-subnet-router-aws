# Copy to .env, fill in, then load it into your shell:
#
#   cp .env.example .env
#   source .env
#
# .env is gitignored. Terraform has no built-in support for env files, so this is
# sourced rather than read: sourcing is what turns these lines into the TF_VAR_*
# environment variables Terraform looks for. Once per shell.
#
# AWS credentials come from a named profile in ~/.aws/credentials, which is where
# every AWS tool already looks. That keeps one copy of the secret on the machine
# rather than one per project, and keeps it out of this file entirely.
#
#   [tailscale-aws]
#   aws_access_key_id = ...
#   aws_secret_access_key = ...
#
export AWS_PROFILE=''

# If you would rather not use a profile, delete AWS_PROFILE above and set these
# instead. Terraform reads them directly. The trade-off is that the secret now
# lives in this file, so rotating it is per-project rather than per-machine.
# export AWS_ACCESS_KEY_ID=''
# export AWS_SECRET_ACCESS_KEY=''

# Trust credential, under Settings > Trust credentials. Auth Keys set to Write,
# tagged with tag:aws-subnet-router and tag:aws-app. Used by terraform.
export TF_VAR_tailscale_oauth_client_id=''
export TF_VAR_tailscale_oauth_client_secret=''

# API access token, under Settings > Keys. A separate credential, used by verify.py.
export TS_API_TOKEN=''

# Tailnet name as shown in the admin console. Not a secret.
export TF_VAR_tailnet=''

# Optional, shown with their defaults. Nothing is pinned to a region: change it
# and the AMI and availability zone follow. Instance type availability is decided
# per availability zone, so if AWS rejects t3.micro in a new region, pick one that
# zone offers.
# export TF_VAR_region='us-west-2'
# export TF_VAR_instance_type='t3.micro'
